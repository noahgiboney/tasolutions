# Copy to .env.local for local dev, and add the same names in Vercel:
# Project → Settings → Environment Variables.

# Resend API key (https://resend.com/api-keys). Server-side only; never
# prefix with VITE_ or it would be bundled into the public site.
RESEND_API_KEY=

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=email@tasolutions.com

# Sender. onboarding@resend.dev works right away but only delivers to the
# Resend account owner's address. After verifying tasolutions.com in Resend,
# switch to something like: TAS Website <website@tasolutions.com>
CONTACT_FROM_EMAIL=TAS Website <onboarding@resend.dev>
